PORT=3007
NODE_ENV=production
LOG_LEVEL=info
JWT_SECRET=super_secret_jwt_key_for_local_dev
DATABASE_URL=postgresql://ipms_notification:ipms_notification@postgres-notification:5432/ipms_notification
NOTIFICATION_DATABASE_URL=postgresql://ipms_notification:ipms_notification@postgres-notification:5432/ipms_notification
NATS_URL=nats://nats:4222
IAM_INTERNAL_URL=http://iam:3001
# Shared with iam. Authenticates the reviewer lookup, which has no user token.
INTERNAL_SERVICE_KEY=local_dev_internal_service_key
# Push notifications through Firebase Cloud Messaging (free). The service-account key is a SECRET: it lives in
# notification.secrets.env (git-ignored, one line: FCM_SERVICE_ACCOUNT_JSON=<whole key JSON on one line>).
# Without it push is off and notifications stay in-app. See docs/push-notifications.md.
