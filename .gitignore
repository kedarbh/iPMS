# Flutter / Mobile
apps/mobile/.dart_tool/
apps/mobile/build/
apps/mobile/.flutter-plugins
apps/mobile/.flutter-plugins-dependencies
apps/mobile/.packages

# Local secrets & tokens
github
githubaccess

# Local databases written by the agent tooling plugins (ruflo, claude-mem).
# Regenerated on demand, and written into whichever directory the tool happens
# to run from — hence matched at any depth rather than only at the root.
ruvector.db
agentdb.rvf
agentdb.rvf.lock

# Generated by Next.js, and not stably: `next dev` points it at .next/dev/types,
# `next build` and `next typegen` at .next/types. Tracking it meant every switch
# between the two produced a diff. `typecheck` regenerates it before tsc.
apps/web/next-env.d.ts

# Real object-storage credentials live only on servers.
docker/env/*.secrets.env

# Firebase client config: downloaded per developer from the Firebase console (see docs/push-notifications.md).
# CI secret scanning flags the API key inside it, so it is not committed.
apps/mobile/android/app/google-services.json
apps/mobile/ios/Runner/GoogleService-Info.plist
